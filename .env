GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
MODEL_NAME=openai/gpt-oss-120b
TEMPERATURE=0.2

# SMTP (Gmail)
SMTP_FROM=your_email@gmail.com
SMTP_APP_PASSWORD=your_password_here
SMTP_TO_OVERRIDE=

# Gmail credentials for auto-reply (IMAP + SMTP)
GMAIL_USER=your_email@gmail.com
GMAIL_PASSWORD=your_password_here

# Selenium watcher (optional fallback for Gmail detection)
USE_SELENIUM_WATCHER=false
# GMAIL_SELENIUM_PROFILE=C:\\Users\\user\\AppData\\Local\\Google\\Chrome\\User Data
# CHROME_DRIVER_PATH=C:\\path\\to\\chromedriver.exe

# --- Vector DB paths ---pip install torch sentence-transformers
# RESUME_DB_PATH=my_vectorstore/resumes
# JD_DB_PATH=my_vectorstore/jds
RESUME_DB_PATH=vectorstore/resumes
JD_DB_PATH=vectorstore/jds

# --- Embedding model ---
EMBED_MODEL=sentence-transformers/paraphrase-MiniLM-L3-v2

