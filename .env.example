# Copy to .env and fill in values before running locally

# LLM / Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gmail SMTP (use app password; do not commit real values)
GMAIL_USER=
GMAIL_PASSWORD=
SMTP_FROM=
SMTP_APP_PASSWORD=
# Optional: override recipient for testing
SMTP_TO_OVERRIDE=

# Vector store locations
RESUME_DB_PATH=vectorstore/resumes
JD_DB_PATH=vectorstore/jds

# Embeddings
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
